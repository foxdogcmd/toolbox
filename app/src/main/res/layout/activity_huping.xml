<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <include layout="@layout/login_card" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#757575"
        android:textSize="13sp" />

    <!-- 测评信息：整行可点，折叠 / 展开 -->
    <LinearLayout
        android:id="@+id/infoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/infoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="测评信息"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infoToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="展开"
            android:textColor="#1565C0"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.25"
        android:textColor="#6D4C41"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFF8E1"
        android:lineSpacingMultiplier="1.2"
        android:padding="8dp"
        android:text="本工具只「保存」草稿，不会替你提交；评分完成后请到学工系统提交。"
        android:textColor="#8D6E63"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="每项打分"
            android:textColor="#424242"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/scoreInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="分数"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:text="20"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="批量保存" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/onlyUnscored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="仅未评价的同学（不覆盖已保存的）"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="点某位同学可逐项打分（同样只保存）"
        android:textColor="#9E9E9E"
        android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>
